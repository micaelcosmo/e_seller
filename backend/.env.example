# Ambiente
APP_ENV=dev
APP_SECRET_KEY=dev-secret-change-me

# Banco: SQLite por padrão (zero setup). Para Docker/Postgres, troque por:
# postgresql+psycopg://e_seller:senha@db:5432/e_seller
DATABASE_URL=sqlite:///./e_seller.db

# Armazenamento dos arquivos de e-book (volume protegido)
STORAGE_DIR=storage/ebooks

# URL base pública (usada nos links de checkout/download). Em túnel, troque pelo domínio.
BASE_URL=http://localhost:48080

# Provedor de pagamento: "fake" (simulador local, sem conta) ou "mercadopago"
PAYMENT_PROVIDER=fake

# Regras de download
DOWNLOAD_TTL_DAYS=7
DOWNLOAD_MAX=5

# Portas não-padrão (ver .spec/unit/infra/ports.md)
BACKEND_PORT=48080
